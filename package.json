{
  "name": "easyvoca",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/compile-content.mjs && node scripts/make-icons.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/compile-content.mjs && node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build",
